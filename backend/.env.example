# Server Config
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialsync?schema=public"

# JWT Authentication
JWT_SECRET="socialsync_super_secret_jwt_key_2026"
JWT_EXPIRE="7d"

# Token Encryption Key (Must be 32-byte hex for AES-256-GCM)
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis Config
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# Set to false to run the application using in-memory fallbacks if you don't have Redis running
USE_REDIS=false

# Facebook OAuth (Meta Developer App)
FACEBOOK_CLIENT_ID="YOUR_FACEBOOK_CLIENT_ID"
FACEBOOK_CLIENT_SECRET="YOUR_FACEBOOK_CLIENT_SECRET"
FACEBOOK_REDIRECT_URI="http://localhost:3000/accounts/callback/facebook"

# Google OAuth (YouTube Data API v3)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/accounts/callback/youtube"

# Development Mock Mode
# Set to true to bypass real OAuth checks and publishing APIs with working simulated mock responses
MOCK_MODE=true
